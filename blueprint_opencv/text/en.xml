<?xml version="1.0" encoding="UTF-8"?>
<!--
  Blueprint OpenCV 插件语言文件（en，English）
  group 名与键名与 zh.xml 完全一致（zh.xml 为回退终点参照）。
  校验：.venv\Scripts\python.exe scripts/check_i18n_completeness.py
-->
<texts language="en">
  <group name="toolbar">
    <text key="run">Run</text>
    <text key="stop">Stop</text>
    <text key="save">Save</text>
    <text key="save_as">Save As</text>
    <text key="fit">Fit View</text>
    <text key="status.ready">Ready</text>
    <text key="status.running">Running…</text>
    <text key="status.stopping">Stopping (interrupts after the current node finishes)…</text>
  </group>
  <group name="panel">
    <text key="section.graphs">Blueprints</text>
    <text key="section.nodes">Nodes</text>
    <text key="section.params">Parameters</text>
    <text key="section.preview">Preview</text>
  </group>
  <group name="main">
    <text key="status.saved">Saved "{name}" ({count} nodes)</text>
    <text key="status.loaded">Loaded "{name}" {suffix}</text>
    <text key="status.load_fallback_suffix">(archive missing/corrupted; fell back to the preset graph)</text>
    <text key="status.load_no_data">Loaded, but the graph data could not be retrieved (see log)</text>
    <text key="status.run_done">Run finished: {count} nodes · total {ms} ms</text>
    <text key="status.run_interrupted">Run interrupted: {reason}</text>
    <text key="error.unknown">Unknown error</text>
    <text key="dialog.save_as_title">Save Blueprint As</text>
    <text key="dialog.save_as_label">Archive name:</text>
    <text key="dialog.overwrite_title">Overwrite Archive</text>
    <text key="dialog.overwrite_text">An archive named "{name}" already exists. Overwrite it?</text>
    <text key="fail.run">Run Failed</text>
    <text key="fail.save">Save Failed</text>
    <text key="fail.load">Load Failed</text>
  </group>
  <group name="graph_list">
    <text key="empty">No saved blueprints yet</text>
    <text key="save_as">Save As</text>
    <text key="load">Load</text>
    <text key="rename">Rename</text>
    <text key="delete">Delete</text>
    <text key="dialog.rename_title">Rename Archive</text>
    <text key="dialog.rename_label">New name:</text>
    <text key="dialog.delete_title">Delete Archive</text>
    <text key="dialog.delete_text">Delete archive "{name}"? This action cannot be undone.</text>
    <text key="row.info">{count} nodes · {time}</text>
    <text key="row.unknown_count">?</text>
    <text key="fail.rename">Rename Failed</text>
    <text key="fail.delete">Delete Failed</text>
  </group>
  <group name="node_list">
    <text key="empty">No nodes on the canvas yet</text>
    <text key="locate">Locate</text>
    <text key="rename">Rename</text>
    <text key="delete">Delete</text>
    <text key="dialog.rename_title">Rename Node</text>
    <text key="dialog.rename_label">New title:</text>
    <text key="row.info">{type_name} · {status}</text>
  </group>
  <group name="property">
    <text key="hint.select_node">Select a node on the canvas to view / edit its parameters.</text>
    <text key="hint.no_params">This node has no editable parameters.</text>
    <text key="hint.unknown_type">Unknown parameter type: {type} ({key})</text>
    <text key="header.type_id">Type: {type_name}    ID: {node_id}</text>
    <text key="header.status">Status: {status}</text>
    <text key="header.elapsed">Elapsed: {ms} ms</text>
    <text key="browse">Browse…</text>
    <text key="dialog.open_title">Select Image File</text>
    <text key="dialog.save_title">Select Save Path</text>
    <text key="dialog.file_filter">Image Files (*.png *.jpg *.jpeg *.bmp);;All Files (*)</text>
  </group>
  <group name="preview">
    <text key="hint.empty">Run the pipeline to see preview node results here.</text>
    <text key="hint.decode_failed">Failed to decode the preview image (invalid PNG data).</text>
    <text key="dialog.title">Preview</text>
    <text key="dialog.close">Close</text>
    <text key="info.result">Result: {width}×{height} · {channels} channels · {ms} ms</text>
  </group>
  <group name="status">
    <text key="idle">Idle</text>
    <text key="running">Running</text>
    <text key="done">Done</text>
    <text key="error">Error</text>
  </group>
  <group name="categories">
    <text key="input">Input</text>
    <text key="basic">Basic</text>
    <text key="filter">Filter</text>
    <text key="threshold">Threshold &amp; Edge</text>
    <text key="morphology">Morphology</text>
    <text key="adjust">Adjustment</text>
    <text key="output">Output</text>
  </group>
  <group name="pins">
    <text key="pin.exec">Exec</text>
    <text key="pin.image">Image</text>
  </group>
  <group name="nodes">
    <text key="node.load_image.title">Load Image</text>
