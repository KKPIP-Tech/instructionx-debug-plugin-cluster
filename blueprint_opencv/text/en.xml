    <text key="param.threshold.thresh">Threshold</text>
    <text key="param.threshold.max_value">Max Value</text>
    <text key="param.threshold.thresh_type">Threshold Type</text>
    <text key="param.adaptive_threshold.max_value">Max Value</text>
    <text key="param.adaptive_threshold.method">Adaptive Method</text>
    <text key="param.adaptive_threshold.thresh_type">Threshold Type</text>
    <text key="param.adaptive_threshold.block_size">Block Size</text>
    <text key="param.adaptive_threshold.c">Constant C</text>
