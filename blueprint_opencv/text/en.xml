    <text key="param.resize.height">Height</text>
    <text key="param.resize.scale">Scale Factor</text>
    <text key="param.resize.interpolation">Interpolation</text>
    <text key="param.flip.direction">Direction</text>
    <text key="param.rotate.angle">Angle</text>
    <text key="param.gaussian_blur.ksize">Kernel Size</text>
