    <text key="node.invert.desc">Bitwise inversion for a negative-film effect</text>
    <text key="node.resize.title">Resize</text>
    <text key="node.resize.desc">Scale an image by factor or target width/height</text>
    <text key="node.flip.title">Flip</text>
    <text key="node.flip.desc">Flip an image horizontally / vertically / both</text>
    <text key="node.rotate.title">Rotate</text>
    <text key="node.rotate.desc">Rotate 90° CW / 180° / 90° CCW</text>
    <text key="node.gaussian_blur.title">Gaussian Blur</text>
    <text key="node.gaussian_blur.desc">Gaussian weighted smoothing (sigma derived from kernel size when 0)</text>
    <text key="node.median_blur.title">Median Blur</text>
    <text key="node.median_blur.desc">Median filter denoising (effective on salt-and-pepper noise)</text>
    <text key="node.bilateral.title">Bilateral Filter</text>
    <text key="node.bilateral.desc">Edge-preserving smoothing filter</text>
    <text key="node.threshold.title">Threshold</text>
    <text key="node.threshold.desc">Fixed-threshold binarization (auto grayscale)</text>
    <text key="node.adaptive_threshold.title">Adaptive Threshold</text>
    <text key="node.adaptive_threshold.desc">Adaptive binarization by local neighborhood (auto grayscale)</text>
    <text key="node.canny.title">Canny Edges</text>
    <text key="node.canny.desc">Canny edge detection</text>
    <text key="node.morphology.title">Morphology</text>
    <text key="node.morphology.desc">Erode / dilate / open / close / gradient / top-hat / black-hat</text>
    <text key="node.brightness_contrast.title">Brightness &amp; Contrast</text>
    <text key="node.brightness_contrast.desc">Linearly adjust brightness and contrast</text>
    <text key="node.sharpen.title">Sharpen</text>
    <text key="node.sharpen.desc">Sharpen via unsharp masking</text>
    <text key="node.hsv_convert.title">HSV Convert</text>
    <text key="node.hsv_convert.desc">Convert between BGR and HSV color spaces</text>
    <text key="node.preview.title">Preview</text>
    <text key="node.preview.desc">Pass the image through and send the result to the preview panel</text>
    <text key="node.save_image.title">Save Image</text>
    <text key="node.save_image.desc">Write the image to the specified file path</text>
  </group>
