/* Text Formatting Plugin - Main Widget Styles */

#TextFormattingWidget QLabel[heading="true"] {
    font-size: 16px;
    font-weight: bold;
    color: {textPrimary};
}

#TextFormattingWidget QGroupBox {
    font-weight: bold;
    border: 1px solid {borderLight};
    border-radius: {radius};
    margin-top: 8px;
    padding-top: 8px;
}

#TextFormattingWidget QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: {textPrimary};
}

#TextFormattingWidget QLineEdit {
    padding: 6px 8px;
    border: 1px solid {borderLight};
    border-radius: {radius};
    background-color: {base};
    color: {textPrimary};
}

#TextFormattingWidget QLineEdit:focus {
    border-color: {accent};
}

#TextFormattingWidget QLineEdit:disabled {
    background-color: {controlFillDisabled};
    color: {textDisabled};
}

#TextFormattingWidget QPushButton {
    padding: 6px 16px;
    border: 1px solid {borderLight};
    border-radius: {radius};
    background-color: {button};
    color: {buttonText};
    min-height: 28px;
}

#TextFormattingWidget QPushButton:hover {
    background-color: {controlFillHover};
    border-color: {border};
}

#TextFormattingWidget QPushButton:pressed {
    background-color: {controlFillPressed};
}

#TextFormattingWidget QPushButton:disabled {
    background-color: {controlFillDisabled};
    color: {textDisabled};
}
