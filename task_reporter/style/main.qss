/* Task Reporter Plugin Styles */

#MainWidget {
    background-color: {window};
    color: {textPrimary};
}

#MainWidget QLabel {
    color: {textPrimary};
    background-color: transparent;
}

#MainWidget QPushButton {
    background-color: {button};
    color: {buttonText};
    border: 1px solid {borderLight};
    padding: 5px 15px;
    border-radius: {radius};
}

#MainWidget QPushButton:hover {
    background-color: {controlFillHover};
    border-color: {border};
}

#MainWidget QTextEdit {
    background-color: {base};
    color: {textPrimary};
    border: 1px solid {borderLight};
    border-radius: {radius};
}

#MainWidget QListWidget {
    background-color: {base};
    color: {textPrimary};
    border: 1px solid {borderLight};
}

#MainWidget QComboBox {
    background-color: {base};
    color: {textPrimary};
    border: 1px solid {borderLight};
    padding: 3px 5px;
}

#MainWidget QTabWidget::pane {
    border: 1px solid {borderLight};
    background-color: {window};
}
