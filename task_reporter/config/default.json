{
  "plugin": {
    "name": "task_reporter",
    "version": "1.0.0"
  },
  "ui": {
    "margins": [16, 16, 16, 16],
    "spacing": 16
  },
  "refresh": {
    "interval_ms": 3000,
    "event_history_limit": 20
  },
  "task_manager": {
    "default_key": "TaskManager",
    "statistics_key": "statistics",
    "last_event_key": "last_event"
  },
  "report": {
    "default_format": "json",
    "supported_formats": ["json", "txt", "html"],
    "event_limit": 50,
    "event_display_limit": 10
  }
}
