/* API Demo Plugin Styles */

#ApiDemoWidget {
    background-color: {window};
    color: {textPrimary};
}

#ApiDemoWidget QLabel {
    color: {textPrimary};
    background-color: transparent;
}

#ApiDemoWidget QPushButton {
    background-color: {button};
    color: {buttonText};
    border: 1px solid {borderLight};
    padding: 5px 15px;
    border-radius: {radius};
}

#ApiDemoWidget QPushButton:hover {
    background-color: {controlFillHover};
    border-color: {border};
}

#ApiDemoWidget QPushButton:pressed {
    background-color: {controlFillPressed};
}

#ApiDemoWidget QTextEdit {
    background-color: {base};
    color: {textPrimary};
    border: 1px solid {borderLight};
    border-radius: {radius};
}

#ApiDemoWidget QListWidget {
    background-color: {base};
    color: {textPrimary};
    border: 1px solid {borderLight};
}

#ApiDemoWidget QListWidget::item:selected {
    background-color: {accentDark};
}

#ApiDemoWidget QComboBox {
    background-color: {button};
    color: {buttonText};
    border: 1px solid {borderLight};
    padding: 3px 5px;
}
