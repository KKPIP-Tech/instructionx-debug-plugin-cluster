/* Framework API Demo Plugin Styles — 仅保留插件特有增强，基础样式由全局 QSS 提供 */

#FrameworkApiDemoWidget {
    background-color: transparent;
}

/* 结果展示区 */
#FrameworkApiDemoWidget QTextEdit#resultDisplay {
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    line-height: 1.5;
}

/* 日志区域 */
#FrameworkApiDemoWidget QTextEdit#logText {
    max-height: 160px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 11px;
    line-height: 1.4;
}

/* 右侧 GroupBox 紧凑化 */
#FrameworkApiDemoWidget QGroupBox {
    margin-top: 6px;
    padding-top: 8px;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
}

/* 右侧列表高度限制 */
#FrameworkApiDemoWidget QListWidget {
    min-height: 40px;
    max-height: 100px;
}
